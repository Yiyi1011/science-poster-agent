# Runtime
APP_ENV=development
MOCK_AI=true
ALLOWED_ORIGINS=http://localhost:5173

# Alibaba Cloud Model Studio / Bailian (configure locally; never commit real keys)
DASHSCOPE_API_KEY=
# Prefer the full OpenAI-compatible Base URL shown in the current Beijing workspace API Key page.
# The workspace-specific Base URL and API Key must be copied from the same workspace.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_REGION=cn-beijing
BAILIAN_WORKSPACE_ID=
BAILIAN_APP_ID=
# Optional override. Leave empty to derive /api/v1 from the workspace-specific Base URL above.
DASHSCOPE_APP_BASE_URL=
RETRIEVAL_MIN_SCORE=0.50

# Model IDs must match the models available in the Beijing workspace.
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=
QWEN_IMAGE_MODEL=qwen-image-3.0
WAN_VIDEO_MODEL=

# First real image trial. qwen-image-3.0 1K list price checked on 2026-08-29.
QWEN_IMAGE_OUTPUT_PRICE=0.18
IMAGE_GENERATION_BUDGET_CNY=10
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.6
QWEN_TTS_PRICE_PER_10K_CHARS=1
TTS_BUDGET_CNY=2
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_VISION_INPUT_PRICE_PER_MILLION=0.15
QWEN_VISION_OUTPUT_PRICE_PER_MILLION=1.5

# Cost guardrails. Update price assumptions when the official model price changes.
QWEN_INPUT_PRICE_PER_MILLION=0.8
QWEN_OUTPUT_PRICE_PER_MILLION=2.0
BUDGET_LIMIT_CNY=100
BUDGET_PAUSE_CNY=70
